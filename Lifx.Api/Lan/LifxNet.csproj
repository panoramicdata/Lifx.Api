<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LifxNet</RootNamespace>
    <AssemblyName>LifxNet</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Company>Morten Nielsen</Company>
    <Version>2.2.0</Version>
    <Authors>Morten Nielsen</Authors>
    <Description>Library for controlling LIFX light bulbs</Description>
    <Copyright>© Morten Nielsen 2015-2020</Copyright>
    <PackageTags>iot, lifx home automation uwp winphone winrt</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/dotMorten/LifxNet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dotMorten/LifxNet</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <NeutralResourcesLanguage>en</NeutralResourcesLanguage>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <RepositoryType>git</RepositoryType>
    <LangVersion>8.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IncludeSymbols>true</IncludeSymbols>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageId>LifxNet</PackageId>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
</Project>